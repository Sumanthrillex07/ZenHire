# ==============================================================================
# ZenHire Environment Configuration Template
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=zenhire_db
DB_USER=zenhire_user
DB_PASSWORD=zenhire_secure_pass_2026

# Spring Data JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Security & JWT Secrets
# Minimum 256-bit (32 characters) secret key for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# File Upload Configuration
FILE_UPLOAD_DIR=/app/uploads
FILE_MAX_SIZE=5MB
FILE_MAX_REQUEST_SIZE=6MB

# AI Integration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=ZenHire
